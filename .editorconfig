root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

[go.mod]
indent_style = tab
indent_size = tab
tab_width = 8

# Markdown and configuration examples contain meaningful whitespace.
[*.md]
trim_trailing_whitespace = false

[examples/*.txt]
trim_trailing_whitespace = false

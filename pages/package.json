{
  "name": "dotreg-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "node scripts/prepare-content.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-content.mjs && astro build && node scripts/check-site.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "parse5": "8.0.1"
  }
}
